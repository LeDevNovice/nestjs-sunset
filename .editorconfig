root = true

# Defaults for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown: trailing spaces are intentional (line break = two trailing spaces)
[*.md]
trim_trailing_whitespace = false

# JSON / YAML: always 2 spaces, already covered by default above
# (explicit for clarity)
[*.{json,yml,yaml}]
indent_size = 2
