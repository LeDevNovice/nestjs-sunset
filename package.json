{
  "name": "nestjs-sunset",
  "version": "0.1.0",
  "description": "API deprecation lifecycle for NestJS",
  "keywords": [
    "nestjs",
    "api",
    "deprecation",
    "lifecycle",
    "sunset",
    "openapi",
    "swagger",
    "http",
    "http-headers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeDevNovice/nestjs-sunset.git"
  },
  "license": "MIT",
  "author": "LeDevNovice <gregory.saison@proton.me>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "bugs": {
    "url": "https://github.com/LeDevNovice/nestjs-sunset/issues"
  },
  "homepage": "https://github.com/LeDevNovice/nestjs-sunset#readme",
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "eslint": "^10.7.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.9",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.64.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
