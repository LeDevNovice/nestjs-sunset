{
  "name": "nestjs-sunset",
  "version": "1.0.1",
  "description": "RFC-compliant API deprecation lifecycle for NestJS (RFC 9745 + RFC 8594 + RFC 8288)",
  "keywords": [
    "nestjs",
    "api",
    "deprecation",
    "sunset",
    "rfc9745",
    "rfc8594",
    "rfc8288",
    "openapi",
    "swagger",
    "lifecycle",
    "http-headers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeDevNovice/nestjs-sunset.git"
  },
  "license": "MIT",
  "author": "LeDevNovice <gregory.saison@proton.me>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "eslint .",
    "lint:pkg": "publint && npx @arethetypeswrong/cli --pack .",
    "prepare": "husky",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "prepublishOnly": "npm run build && npm run typecheck && npm run lint && npm run test:coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "bugs": {
    "url": "https://github.com/LeDevNovice/nestjs-sunset/issues"
  },
  "homepage": "https://github.com/LeDevNovice/nestjs-sunset#readme",
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/testing": "^11.1.28",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "fastify": "^5.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "publint": "^0.3.21",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "tsdown": "^0.22.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0",
    "unplugin-swc": "^1.5.9",
    "unrun": "^0.3.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "@nestjs/swagger": ">=10.0.0",
    "reflect-metadata": ">=0.1.0",
    "rxjs": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
